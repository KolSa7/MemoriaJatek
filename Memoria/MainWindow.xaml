<Window x:Class="Memoria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Memoria"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="4*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="menu" Grid.Column="0">
            <Label Content="Pálya mérete"/>
            <ListBox x:Name="lbox_meret"/>
            <Label Content="Tematika"/>
            <ListBox  x:Name="lbox_palyak"/>
            <Button  x:Name="btn_start" Content="Kezdés" Click="btn_start_Click"/>
            
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="tries" Text="Próbálkozások: 0" Visibility="Hidden"/>
            <Grid x:Name="gameGrid"/>
        </StackPanel>
    </Grid>
</Window>
